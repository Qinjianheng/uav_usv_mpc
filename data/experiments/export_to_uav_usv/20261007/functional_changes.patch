--- /dev/null
+++ b/src/uav_usv_bringup/config/front_tof_simulation.yaml
@@ -0,0 +1,23 @@
+# Uncalibrated functional simulation. These are engineering test assumptions,
+# not a manufacturer's specification or evidence of outdoor/sea performance.
+# The rendering backend retains the baseline aligned RGB/depth optical geometry.
+front_tof_depth_model:
+  ros__parameters:
+    input_topic: /camera/front/depth/ideal
+    output_topic: /camera/front/depth/image_raw
+    horizontal_fov: 1.74
+    minimum_range: 0.25
+    maximum_range: 25.0
+    # Per-pixel radial error sigma [m] = noise_std + range_noise_scale * range.
+    noise_std: 0.01
+    range_noise_scale: 0.001
+    dropout_probability: 0.01
+    quantization: 0.001
+    seed: 0
+
+# The fitter uses the same radial noise budget as the measurement model.
+# Explicit mode selection in launch retains the legacy ideal-depth path.
+rgbd_target_localizer:
+  ros__parameters:
+    sphere_noise_std: 0.01
+    sphere_range_noise_scale: 0.001
